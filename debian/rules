#!/usr/bin/make -f

%:
	dh $@

# Both supported build paths use the same clean source allowlist.
override_dh_auto_build:

# Validation runs in the locked release environment before packaging.
override_dh_auto_test:

override_dh_auto_install:
	python3 scripts/stage_debian.py . debian/glimpser/opt/glimpser

# postinst handles service startup after the locked virtualenv is ready.
override_dh_installsystemd:
	dh_installsystemd --no-scripts
