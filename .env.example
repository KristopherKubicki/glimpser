# Example environment configuration for Glimpser
# Copy this file to `.env` and edit the values as needed.

# Core settings
SECRET_KEY=
API_KEY=
CHATGPT_KEY=
HOST=0.0.0.0
PORT=8082
DEBUG=True
LOG_LEVEL=WARN
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_TIMEOUT_MINUTES=30

# Database and logging paths
GLIMPSER_DATABASE_PATH=data/glimpser.db
GLIMPSER_LOGGING_PATH=logs/glimpser.log
GLIMPSER_BACKUP_PATH=data/config_backup.json

# File locations
SCREENSHOT_DIRECTORY=data/screenshots/
VIDEO_DIRECTORY=data/video/
SUMMARIES_DIRECTORY=data/summaries/

# Email settings
EMAIL_ENABLED=False
EMAIL_SENDER=
EMAIL_RECIPIENTS=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=True
EMAIL_USERNAME=
EMAIL_PASSWORD=

# External binaries
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_HWACCEL=False

# LLM configuration
LLM_MODEL_VERSION=gpt-4.1-mini
# Uncomment and customize the prompts if needed
# LLM_SUMMARY_PROMPT=
# LLM_CAPTION_PROMPT=

# Video probe sizes
PROBE_SIZE_DEFAULT=5M
PROBE_SIZE_RTSP=10M
PROBE_SIZE_OTHER=20M

# SMS settings
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMBER=

